# Copie para .env e ajuste. Nunca versione o arquivo .env.

PORT=3000
# production ativa cookies "Secure" (exige HTTPS)
NODE_ENV=development
# URL pública usada no sitemap e nas tags de SEO (no Render vem automática)
PUBLIC_URL=http://localhost:3000
# true = aparece no Google. Deixe false enquanto a loja for demonstrativa.
ALLOW_INDEXING=false
# true quando roda atrás de proxy (Render, Cloudflare) para ler o IP real do visitante
TRUST_PROXY=false

# Acesso administrativo. Se ADMIN_PASSWORD ficar vazio, uma senha aleatória
# é gerada no primeiro início e gravada em data/runtime/admin-credentials.txt
ADMIN_EMAIL=admin@hc.local
ADMIN_PASSWORD=

# Gateway de pagamento (ainda não integrado). Valores possíveis no futuro:
# mercadopago | stripe | pagarme. Vazio = checkout bloqueado antes do pagamento.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# Transportadora (ainda não integrada). Vazio = tabela de estimativa provisória.
SHIPPING_PROVIDER=
SHIPPING_ORIGIN_CEP=
